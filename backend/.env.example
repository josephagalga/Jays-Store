# Initial admin (created/reset by build.sh on deploy — never commit real values)
ADMIN_EMAIL=admin@jaysstore.com
# ADMIN_PASSWORD=set-a-strong-password-in-production-env-only
# ADMIN_FIRST_NAME=Jay
# ADMIN_LAST_NAME=Admin

# Django Secret Key
SECRET_KEY=your-secret-key-here

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Optional - defaults to local sqlite3 if not set)
# DATABASE_URL=postgres://user:password@localhost:5432/jays_store
# DB_PASSWORD=your_postgres_password

# Gemini AI API Key (required for AI recommendations and stylist)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Configuration (Optional - for cloud media storage in production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Optional - defaults to standard local dev ports)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Paystack (for online payments + webhook verification)
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Public frontend URL (Paystack callback + CORS reference)
FRONTEND_URL=http://localhost:5173

# Email via Gmail API over HTTPS (works on Render free tier, where outbound
# SMTP ports 25/465/587 are blocked and plain SMTP hangs the worker).
# No custom domain needed — mail sends from your Gmail account.
# 1. Google Cloud project -> enable Gmail API
# 2. OAuth consent (External) + scope https://www.googleapis.com/auth/gmail.send
# 3. Create OAuth client (Desktop) -> note client ID + secret
# 4. Generate refresh token: gmail_oauth2 --ugo2t --credentials_path <downloaded json>
# 5. Set the three vars below, redeploy. Until set, local dev prints mail to
#    console and production _send() logs 'GMAIL_API_REFRESH_TOKEN missing'.
GMAIL_API_CLIENT_ID=your_google_oauth_client_id
GMAIL_API_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_API_REFRESH_TOKEN=your_google_oauth_refresh_token
# Order alerts live in the on-site inbox (buyer orders / seller orders /
# admin attention). Set True to ALSO email order confirmations (needs Gmail
# API above). Password-reset mail always sends regardless of this flag.
# NOTIFY_ORDER_EMAIL_ENABLED=False
# Email (payment confirmations, OTP + receipts). Gmail SMTP fallback below is
# only for hosts where outbound SMTP is allowed (NOT Render free tier).
# 1. Enable 2-Step Verification on the Google account
# 2. Create an App Password (Google Account → Security → App passwords)
# 3. Paste the 16-letter code below (NOT your login password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=myjaysstore@gmail.com
EMAIL_HOST_PASSWORD=paste-your-16-letter-app-password-here
DEFAULT_FROM_EMAIL=Jay's Store <myjaysstore@gmail.com>

# Store owner — paid-alert email on every confirmed order
ADMIN_NOTIFICATION_EMAIL=myjaysstore@gmail.com

# SMS via Hubtel — DEFERRED (email-only for now). Add later when ready:
# HUBTEL_CLIENT_ID=your-hubtel-client-id
# HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
# HUBTEL_SENDER_ID=JaysStore

# Paystack Ghana gateway fee pass-on (defaults match current pricing)
# PAYSTACK_GH_FEE_RATE=0.0195
# PAYSTACK_GH_FEE_CAP=10.00
