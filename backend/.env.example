# Django Secret Key
SECRET_KEY=your-secret-key-here

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Optional - defaults to local sqlite3 if not set)
# DATABASE_URL=postgres://user:password@localhost:5432/jays_store
# DB_PASSWORD=your_postgres_password

# Gemini AI API Key (required for AI recommendations and stylist)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Configuration (Optional - for cloud media storage in production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Optional - defaults to standard local dev ports)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Paystack (for online payments + webhook verification)
PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# Public frontend URL (Paystack callback + CORS reference)
FRONTEND_URL=http://localhost:5173
